# Address the HTTP server binds to.
HALDEN_LISTEN_ADDR=:8080

# PEM-encoded RSA private key used to sign the short-lived tokens presented to
# downstream Halden services. Required. The private half stays here; downstream
# services hold only the matching public key, so none of them can mint a token.
# Sourced from Key Vault in deployed environments.
HALDEN_INTERNAL_TOKEN_PRIVATE_KEY=CHANGE_ME

# TLS material for calling halden-threat-detection. All optional: with none
# set, calls use the default transport, which is how this ran before internal
# TLS existed. Verification is never disabled — the CA bundle is how an
# internally-issued certificate is trusted.
#
# THREAT_DETECTION_TLS_CA_BUNDLE signs the downstream service's certificate.
# The client cert and key present this service's own identity for mutual TLS,
# and must be set together.
THREAT_DETECTION_TLS_CA_BUNDLE=
THREAT_DETECTION_CLIENT_CERT=
THREAT_DETECTION_CLIENT_KEY=

# Base URL of halden-threat-detection. Switch to https://...:8443 once the
# downstream service is serving TLS and the CA bundle above is in place.
THREAT_DETECTION_URL=http://halden-threat-detection.halden.svc.cluster.local:8000

# Auth0 tenant settings used to validate incoming access tokens.
AUTH0_JWKS_URL=https://halden.eu.auth0.com/.well-known/jwks.json
AUTH0_ISSUER=https://halden.eu.auth0.com/
AUTH0_AUDIENCE=https://api.halden.io

# Floor on how often the Auth0 JWKS is refetched, and therefore the ceiling on
# how long a revoked Auth0 signing key still validates tokens here. Optional;
# defaults to 300 seconds and is clamped to 900. A larger value is not a tuning
# choice, it is the control switched off, so it is clamped rather than honoured.
JWKS_CACHE_MIN_TTL_SECONDS=300
