# Address the HTTP server binds to.
HALDEN_LISTEN_ADDR=:8080

# Secret used to sign the short-lived tokens presented to downstream Halden
# services. Sourced from Key Vault in deployed environments.
HALDEN_INTERNAL_TOKEN_SECRET=CHANGE_ME

# PEM-encoded RSA private key used to sign downstream tokens with RS256, so the
# verifying service holds only the public half and cannot mint tokens. Optional:
# while it is empty, downstream tokens are signed HS256 with the shared secret
# above. Do not set it until halden-threat-detection has the matching public key
# in HALDEN_INTERNAL_TOKEN_PUBLIC_KEY, or every internal call will be refused.
HALDEN_INTERNAL_TOKEN_PRIVATE_KEY=

# Base URL of halden-threat-detection.
THREAT_DETECTION_URL=http://halden-threat-detection.halden.svc.cluster.local:8000

# Auth0 tenant settings used to validate incoming access tokens.
AUTH0_JWKS_URL=https://halden.eu.auth0.com/.well-known/jwks.json
AUTH0_ISSUER=https://halden.eu.auth0.com/
AUTH0_AUDIENCE=https://api.halden.io
