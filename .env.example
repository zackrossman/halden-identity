# Address the HTTP server binds to.
HALDEN_LISTEN_ADDR=:8080

# PEM-encoded RSA private key used to sign the short-lived tokens presented to
# downstream Halden services. Required. The private half stays here; downstream
# services hold only the matching public key, so none of them can mint a token.
# Sourced from Key Vault in deployed environments.
HALDEN_INTERNAL_TOKEN_PRIVATE_KEY=CHANGE_ME

# Base URL of halden-threat-detection.
THREAT_DETECTION_URL=http://halden-threat-detection.halden.svc.cluster.local:8000

# Auth0 tenant settings used to validate incoming access tokens.
AUTH0_JWKS_URL=https://halden.eu.auth0.com/.well-known/jwks.json
AUTH0_ISSUER=https://halden.eu.auth0.com/
AUTH0_AUDIENCE=https://api.halden.io
